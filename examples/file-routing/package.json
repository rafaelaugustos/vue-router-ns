{
  "name": "native-file-routes-example",
  "private": true,
  "version": "1.0.0",
  "main": "src/app.ts",
  "scripts": {
    "setup": "node scripts/resources.mjs && npm run routes:android",
    "routes:android": "node scripts/routes.mjs android",
    "routes:ios": "node scripts/routes.mjs ios",
    "typecheck": "tsc --noEmit",
    "build:android": "webpack --env android",
    "build:ios": "webpack --env ios"
  },
  "dependencies": {
    "@nativescript/core": "~9.1.3",
    "nativescript-vue": "3.1.2",
    "vue-router-ns": "file:../.."
  },
  "devDependencies": {
    "@nativescript/android": "9.1.1",
    "@nativescript/ios": "9.1.0",
    "@nativescript/types": "~9.1.1",
    "@nativescript/webpack": "~5.0.38",
    "@vue/compiler-sfc": "^3.5.44",
    "@types/node": "^22.20.5",
    "typescript": "^6.0.3"
  }
}
