{
  "name": "native-file-routes-example",
  "private": true,
  "version": "1.0.0",
  "main": "src/app.ts",
  "scripts": {
    "setup": "node scripts/resources.mjs && npm run routes:android",
    "routes:android": "node scripts/routes.mjs android",
    "routes:ios": "node scripts/routes.mjs ios",
    "typecheck": "tsc --noEmit",
    "build:android": "webpack --env android",
    "build:ios": "webpack --env ios",
    "build:vite:android": "ROUTER_BUNDLER=vite vite build --config vite.config.mts --mode development -- --env.android",
    "build:vite:ios": "ROUTER_BUNDLER=vite vite build --config vite.config.mts --mode development -- --env.ios",
    "run:vite:android": "ROUTER_BUNDLER=vite ns run android",
    "run:vite:ios": "ROUTER_BUNDLER=vite ns run ios --emulator"
  },
  "dependencies": {
    "@nativescript/core": "~9.1.3",
    "@valor/nativescript-websockets": "^2.0.3",
    "nativescript-vue": "3.1.2",
    "vue-router-ns": "file:../.."
  },
  "devDependencies": {
    "@nativescript/android": "9.1.1",
    "@nativescript/ios": "9.1.0",
    "@nativescript/types": "~9.1.1",
    "@nativescript/vite": "^8.0.20",
    "@nativescript/webpack": "~5.0.38",
    "@types/node": "^22.20.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitejs/plugin-vue-jsx": "^5.1.6",
    "@vue/compiler-sfc": "^3.5.44",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "vue-tsc": "^3.3.13"
  }
}
