{
  "name": "vue-router-ns",
  "version": "0.1.0-beta.4",
  "description": "Vue Router's API for NativeScript-Vue, built on top of the native navigation stack.",
  "keywords": [
    "nativescript",
    "nativescript-vue",
    "vue",
    "vue3",
    "router",
    "vue-router",
    "navigation"
  ],
  "author": "Rafael Augusto",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rafaelaugustos/vue-router-ns.git"
  },
  "homepage": "https://github.com/rafaelaugustos/vue-router-ns#readme",
  "bugs": "https://github.com/rafaelaugustos/vue-router-ns/issues",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "node -e \"fs.rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "@nativescript/core": ">=8.9.0",
    "nativescript-vue": "^3.0.0"
  },
  "devDependencies": {
    "@nativescript/core": "^9.1.3",
    "@vue/runtime-core": "^3.5.44",
    "nativescript-vue": "^3.1.2",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vitepress": "^1.6.4",
    "vitest": "^5.0.4"
  },
  "engines": {
    "node": ">=20"
  }
}
