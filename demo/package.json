{
  "name": "vue-router-ns-demo",
  "private": true,
  "main": "src/app.ts",
  "version": "1.0.0",
  "scripts": {
    "airbnb:prepare": "node scripts/prepare-airbnb.mjs",
    "preairbnb:ios": "npm run airbnb:prepare",
    "airbnb:ios": "ns run ios --env.airbnb",
    "preairbnb:android": "npm run airbnb:prepare",
    "airbnb:android": "ns run android --env.airbnb",
    "airbnb:bundle:ios": "webpack --env ios --env airbnb",
    "airbnb:bundle:android": "webpack --env android --env airbnb",
    "showcase:ios": "ns run ios --env.showcase",
    "showcase:android": "ns run android --env.showcase",
    "tutorial:ios": "ns run ios --env.tutorial",
    "tutorial:android": "ns run android --env.tutorial"
  },
  "dependencies": {
    "@nativescript/core": "9.1.3",
    "nativescript-vue": "3.1.3"
  },
  "devDependencies": {
    "@nativescript/android": "9.1.1",
    "@nativescript/ios": "9.1.0",
    "@nativescript/types": "~9.1.1",
    "@nativescript/webpack": "~5.0.38",
    "@types/node": "~26.5.0",
    "typescript": "^6.0.3"
  }
}
